ht="1" fill="#1b1b1b"/><rect x="2" y="11" width="1" height="1" fill="#1b1b1b"/><rect x="3" y="11" width="4" height="1" fill="#c9d6a0"/><rect x="7" y="11" width="1" height="1" fill="#1b1b1b"/><rect x="12" y="11" width="1" height="1" fill="#1b1b1b"/><rect x="13" y="11" width="5" height="1" fill="#c9d6a0"/><rect x="18" y="11" width="1" height="1" fill="#1b1b1b"/><rect x="23" y="11" width="1" height="1" fill="#1b1b1b"/><rect x="24" y="11" width="3" height="1" fill="#c9d6a0"/><rect x="27" y="11" width="1" height="1" fill="#1b1b1b"/><rect x="3" y="12" width="4" height="1" fill="#1b1b1b"/><rect x="13" y="12" width="5" height="1" fill="#1b1b1b"/><rect x="24" y="12" width="3" height="1" fill="#1b1b1b"/></g></svg>
    </div>
    <div class="stage">
      <div class="term">
        <div class="bar"><i></i><i></i><i></i></div>
        <pre id="term-creature"></pre>
        <div class="caption" id="caption"></div>
        <div class="echo" id="echo"></div>
        <div class="promptline">&gt; <span class="spin" id="spinner"></span><input id="ask" type="text" placeholder={copy.demoPlaceholder} autocomplete="off"></div>
      </div>
      <svg class="sticker" viewBox="0 0 200 200" aria-hidden="true">
        <polygon class="shade" points={seal(16, 90, 78, 100)} transform="translate(6,8)"/>
        <polygon class="face" points={seal(16, 84, 72, 100)}/>
        <ellipse class="gloss" cx="78" cy="62" rx="34" ry="14" transform="rotate(-20 78 62)"/>
        <text x="100" y="92" text-anchor="middle" data-k="sticker"><tspan x="100" y="92">{copy.sticker.split(" ")[0]}</tspan><tspan x="100" y="118">{copy.sticker.split(" ").slice(1).join(" ")}</tspan></text>
      </svg>
    </div>
    <div class="give">
      <span class="lead" data-k="giveIt">{copy.giveIt}</span>
      {Object.entries(copy.senses).map(([k, v]) => (<label><input type="checkbox" data-sense={k} /> <span data-k={`senses.${k}`}>{v}</span></label>))}
      <button id="hide">hide</button>
    </div>
    <div class="installrow">
      <div class="harness"><span class="prompt" aria-hidden="true">&gt;_</span><span data-k="harness">{copy.harness}</span><em data-k="harnessSub">{copy.harnessSub}</em></div>
      <pre class="install"><code id="install-line" data-k="install">{copy.install}</code><button id="copy"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="5" y="5" width="9" height="9" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M11 3.5V3a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v7a1 1 0 0 0 1 1h.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><span data-k="installButton">{copy.installButton}</span></button></pre>
      <div class="note" data-k="installNote">{copy.installNote}</div>
    </div>
    <p class="flavor" data-k="flavor" set:html={inline(copy.flavor)}></p>
  </section>)
  if (id === 'why') return (
  <section data-section="why" id="why" class="prose">
    <div class="fullgrowth">
      <div class="viz tall"><pre id="viz-full"></pre><span class="badge ok" data-k="fullBadge">{copy.fullBadge}</span></div>
      <p class="note" data-k="fullNote">{copy.fullNote}</p>
    </div>
    <h2 class="lab" data-k="whyTitle">{copy.whyTitle}</h2>
    <div>
      <p class="pitch" data-k="pitch" set:html={inline(copy.pitch)}></p>
      <p data-k="what" set:html={inline(copy.what)}></p>
      <p data-k="who" set:html={inline(copy.who)}></p>
      <p data-k="nothing" set:html={inline(copy.nothing)}></p>
    </div>
  </section>)
  if (id === 'forms') return (
  <section data-section="forms" id="forms">
    <div class="band" data-k="formsTitle">{copy.formsTitle}</div>
    <span class="collect" data-k="collect">{copy.collect}</span>
    {copy.forms.map((f, i) => (
      <div class={`row ${i % 2 ? 'flip' : ''}`}>
        <div class="viz">
          {f.status === 'available' ? <pre id={`viz-${f.id}`}></pre> : <span class="q">?</span>}
          <span class={`badge ${f.status === 'available' ? 'ok' : ''}`} data-k={`forms.${i}.badge`}>{f.badge}</span>
        </div>
        <div class="txt">
          <b data-k={`forms.${i}.name`}>{f.name}</b>
          <span class="god"><span data-k={`forms.${i}.god`}>{f.god}</span> · <span data-k={`forms.${i}.line`}>{f.line}</span></span>
          <p data-k={`forms.${i}.desc`}>{f.desc}</p>
          {f.status === 'available'
            ? <button class="btn" data-form={f.id} data-soon="">Select</button>
            : <button class="btn ghost" data-form={f.id} data-soon={copy.soon.replace('{name}', f.name)}>Coming soon to your region</button>}
        </div>
      </div>
    ))}
  </section>)
  if (id === 'schemes') return (
  <section data-section="schemes">
    <div class="band" data-k="schemesTitle">{copy.schemesTitle}</div>
    <div class="schemes">{copy.schemes.map((s, i) => (<div class={`swatch ${i ? 'soon' : ''}`} data-scheme={s}><i></i><span data-k={`schemes.${i}`}>{s}</span></div>))}</div>
  </section>)
  if (id === 'specs') return (
  <section data-section="specs" id="specs">
    <h2 class="lab" data-k="specsTitle">{copy.specsTitle}</h2>
    <dl class="spec">{copy.table.map(([k, v], i) => (<><dt data-k={`table.${i}.0`}>{k}</dt><dd data-k={`table.${i}.1`}>{v}</dd></>))}</dl>
    <h2 class="lab" style="margin-top:36px" data-k="quotesTitle">{copy.quotesTitle}</h2>
    <ul class="quotes">{copy.specs.map((q, i) => <li data-k={`specs.${i}`}>{q}</li>)}</ul>
    <p class="note" data-k="specsNote" set:html={inline(copy.specsNote)}></p>
  </section>)
})}
  <footer><span data-k="footer">{copy.footer}</span><span data-k="footerRight">{copy.footerRight}</span></footer>

  <script is:inline src="/creature.js"></script>
  <script is:inline src="/mascots.js"></script>
</Base>
